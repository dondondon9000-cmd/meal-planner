# Optional production database. Keep this server-side in a Vercel API route; never prefix with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional sourced-recipe search. Use a production supporter key before public launch.
# Optional paid override. Basic private-household search uses TheMealDB's published key 1.
THEMEALDB_API_KEY=

# Optional AI provider for in-app recipe generation (server-side only).
ANTHROPIC_API_KEY=
ANTHROPIC_RECIPE_MODEL=claude-haiku-5-5
